# ============ MAMAHAIR.COM — variables d'environnement ============
# Copier en .env.local (jamais commité). Sur Vercel : Settings → Environment Variables.

# --- Base de données (Supabase → Settings → Database) ---
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth / Storage (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."          # serveur uniquement (uploads, seed admin). JAMAIS côté client.

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_TAX_ENABLED="true"                    # "false" si Stripe Tax n'est pas activé sur le compte

# --- Emails (resend.com, domaine vérifié) ---
RESEND_API_KEY="re_..."
# EMAIL_FROM_OVERRIDE="orders@mamahair.com"  # optionnel : force l'expéditeur (sinon Settings → Email)

# --- Application ---
NEXT_PUBLIC_SITE_URL="https://mamahair.com"
NEXT_PUBLIC_SITE_NAME="MAMAHAIR"
DEFAULT_CURRENCY="USD"
DEFAULT_LOCALE="en"

# --- Crons (Vercel Cron envoie Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET="change-me-long-random-string"
# ABANDONED_CART_CODE="WELCOME10"            # optionnel : code inclus dans l'email de relance panier

# --- Observabilité (optionnel : sans DSN, Sentry est ignoré) ---
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# --- Seed (compte admin créé par `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@mamahair.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- Tests E2E (optionnel) ---
# E2E_ADMIN_EMAIL="admin@mamahair.com"
# E2E_ADMIN_PASSWORD="ChangeMe123!"
